    "code": "const transitions = { draft: [\"queued\"], queued: [\"running\"], running: [\"succeeded\", \"failed\"], failed: [\"queued\"] };\n\nexport function moveJob(job, next) {\n  if (!transitions[job.state]?.includes(next)) return { ok: false };\n  job.state = next;\n  return { ok: true, job };\n}\n",
    "specification": {
