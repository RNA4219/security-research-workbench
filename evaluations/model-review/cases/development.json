      "revision": "spec-3",
      "text": "プロフィールは本人だけが読み取れる。存在しないプロフィールと他人のプロフィールは同じ404結果にする。",
      "requirements": [
        {
          "id": "spec-profile",
          "version": "spec-3",
          "content": "プロフィールは認証済みactorのidと所有者idを照合する。"
        }
      ]
    },
